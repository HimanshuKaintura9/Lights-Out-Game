
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Play Lights Out</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <main class="page-container game-page">
        <header class="game-header">
            <a class="back-link" href="/">← Back to setup</a>
            <p class="eyebrow">PUZZLE IN PROGRESS</p>
            <h1>Lights <span>Out.</span></h1>
            <p class="subtitle">
                Grid: <%= rows %> × <%= cols %>
            </p>
        </header>

        <section class="game-card">
            <div class="status-row">
                <span id="progressText">Lights ON: 0 / <%= rows * cols %></span>
                <span id="moveText">Moves: 0</span>
            </div>

            <div
            id="gameBoard"
            class="game-board"
            data-rows="<%= rows %>"
            data-cols="<%= cols %>"
            style="--cols: <%= cols %>;"
            aria-label="Lights Out puzzle board">
            </div>

            <p id="statusMessage" class="status-message" role="status">
                Turn every light ON to win.
            </p>

            <div class="game-controls">
                <button id="hintButton" class="secondary-button" type="button">
                    Hint
                </button>
                <button id="solveButton" class="secondary-button" type="button">
                    Show Solution
                </button>
                <button id="resetButton" class="secondary-button" type="button">
                    Reset
                </button>
            </div>

            <div id="hintPanel" class="hint-panel" hidden></div>

            <div id="resultMessage" class="result-message" role="status" hidden>
            </div>
        </section>

        <section class="info-card compact-info">
            <h2>Remember</h2>
            <p>
                A move toggles the chosen cell and its four orthogonal
                neighbours. Use Hint to reveal one move from a valid solution.
                Show Solution displays the full sequence.
            </p>
        </section>
    </main>

    <script>
        const boardElement = document.getElementById("gameBoard");
        const ROWS = Number(boardElement.dataset.rows);
        const COLS = Number(boardElement.dataset.cols);
        const TOTAL = ROWS * COLS;
        
        const progressText = document.getElementById("progressText");
        const moveText = document.getElementById("moveText");
        const statusMessage = document.getElementById("statusMessage");
        const hintPanel = document.getElementById("hintPanel");
        const resultMessage = document.getElementById("resultMessage");

        const hintButton = document.getElementById("hintButton");
        const solveButton = document.getElementById("solveButton");
        const resetButton = document.getElementById("resetButton");

        let board = Array(TOTAL).fill(false);
        let initialBoard = Array(TOTAL).fill(false);
        let moves = 0;
        let hintUsed = false;
        let solutionViewed = false;
        let solved = false;
        let hintedIndex = -1;
        let solutionSteps = [];

        const cells = [];

        function indexOf(row, col) {
            return row * COLS + col;
        }

        function getAffectedCells(index) {
            const row = Math.floor(index / COLS);
            const col = index % COLS;

            const positions = [
                [row, col],
                [row - 1, col],
                [row + 1, col],
                [row, col - 1],
                [row, col + 1]
            ];

            return positions
                .filter(([r, c]) =>
                    r >= 0 && r < ROWS && c >= 0 && c < COLS
                )
                .map(([r, c]) => indexOf(r, c));
        }

        function createBoard() {
            boardElement.innerHTML = "";
            boardElement.style.setProperty("--cols", COLS);

            for (let i = 0; i < TOTAL; i++) {
                const button = document.createElement("button");
                button.type = "button";
                button.className = "cell";
                button.setAttribute("aria-label", `Row ${Math.floor(i / COLS) + 1}, column ${i % COLS + 1}, off`);
                button.setAttribute("aria-pressed", "false");

                button.addEventListener("click", () => {
                    if (solved) return;
                    makeMove(i);
                });

                cells.push(button);
                boardElement.appendChild(button);
            }

            renderBoard();
        }

        function renderBoard() {
            let onCount = 0;

            board.forEach((isOn, index) => {
                if (isOn) onCount++;

                cells[index].classList.toggle("on", isOn);
                cells[index].classList.toggle("hinted", index === hintedIndex);
                const solutionStep = solutionSteps.indexOf(index);
                cells[index].classList.toggle("solution-step", solutionStep !== -1);
                if (solutionStep !== -1) {
                    cells[index].dataset.step = String(solutionStep + 1);
                } else {
                    delete cells[index].dataset.step;
                }
                cells[index].setAttribute("aria-pressed", String(isOn));
                cells[index].setAttribute(
                    "aria-label",
                    `Row ${Math.floor(index / COLS) + 1}, column ${index % COLS + 1}, ${isOn ? "on" : "off"}`
                );
            });

            progressText.textContent = `Lights ON: ${onCount} / ${TOTAL}`;
            moveText.textContent = `Moves: ${moves}`;

            if (onCount === TOTAL) {
                finishPuzzle();
            }
        }

        function makeMove(index) {
            if (solved) return;

            for (const affected of getAffectedCells(index)) {
                board[affected] = !board[affected];
            }

            moves++;
            hintedIndex = -1;
            hintPanel.hidden = true;
            if (solutionViewed && !solved) {
                solutionSteps = findSolution(board) || [];
            }
            renderBoard();
        }

        /*
         * Solve the board as a linear system over GF(2).
         * Each variable represents whether to press a cell.
         * The target is the XOR difference between current board and all-ON.
         */
        function findSolution(sourceBoard) {
            const variableCount = TOTAL;
            const matrix = [];

            for (let row = 0; row < TOTAL; row++) {
                const equation = Array(variableCount + 1).fill(0);

                for (let col = 0; col < variableCount; col++) {
                    if (getAffectedCells(col).includes(row)) {
                        equation[col] = 1;
                    }
                }

                // A cell must toggle if it is currently OFF.
                equation[variableCount] = sourceBoard[row] ? 0 : 1;
                matrix.push(equation);
            }

            let pivotRow = 0;
            const pivotColumns = [];

            for (
                let col = 0;
                col < variableCount && pivotRow < TOTAL;
                col++
            ) {
                let selected = pivotRow;

                while (
                    selected < TOTAL &&
                    matrix[selected][col] === 0
                ) {
                    selected++;
                }

                if (selected === TOTAL) continue;

                [matrix[pivotRow], matrix[selected]] =
                    [matrix[selected], matrix[pivotRow]];

                for (let r = 0; r < TOTAL; r++) {
                    if (r !== pivotRow && matrix[r][col] === 1) {
                        for (let c = col; c <= variableCount; c++) {
                            matrix[r][c] ^= matrix[pivotRow][c];
                        }
                    }
                }

                pivotColumns[pivotRow] = col;
                pivotRow++;
            }

            // Detect contradictory equations: 0 = 1.
            for (let r = pivotRow; r < TOTAL; r++) {
                let allZero = true;

                for (let c = 0; c < variableCount; c++) {
                    if (matrix[r][c] !== 0) {
                        allZero = false;
                        break;
                    }
                }

                if (allZero && matrix[r][variableCount] === 1) {
                    return null;
                }
            }

            // Free variables are set to zero for one valid solution.
            const solution = Array(variableCount).fill(0);

            for (let r = 0; r < pivotRow; r++) {
                solution[pivotColumns[r]] = matrix[r][variableCount];
            }

            return solution
                .map((value, index) => value ? index : -1)
                .filter(index => index !== -1);
        }

        function describeCell(index) {
            return `row ${Math.floor(index / COLS) + 1}, column ${index % COLS + 1}`;
        }

        function useHint() {
            if (solved) return;

            const solution = findSolution(board);

            if (solution === null) {
                statusMessage.textContent =
                    "This board has no solution from its current state. Try Reset.";
                hintPanel.hidden = true;
                return;
            }

            if (solution.length === 0) {
                statusMessage.textContent = "The board is already solved.";
                return;
            }

            hintUsed = true;
            hintedIndex = solution[0];
            hintPanel.textContent =
                `Hint: try clicking ${describeCell(hintedIndex)}.`;
            hintPanel.hidden = false;

            statusMessage.textContent = "Hint revealed. You can still solve it yourself.";
            renderBoard();
        }

        function showSolution() {
            if (solved) return;

            const solution = findSolution(board);

            if (solution === null) {
                statusMessage.textContent =
                    "No solution exists for this board. Reset to try again.";
                return;
            }

            solutionViewed = true;
            hintUsed = true;
            solutionSteps = solution;

            if (solution.length === 0) {
                statusMessage.textContent = "The board is already solved.";
                renderBoard();
                return;
            }

            hintPanel.textContent =
                "Press the highlighted cells in order: " + solution.map(index => describeCell(index)).join(" → ");
            hintPanel.hidden = false;
            statusMessage.textContent = "Solution highlighted. Click the numbered cells in order.";
            renderBoard();
        }

        function finishPuzzle() {
            if (solved) return;
            solved = true;

            cells.forEach(cell => {
                cell.disabled = true;
            });

            hintButton.disabled = true;
            solveButton.disabled = true;

            const details = [];

            if (hintUsed) details.push("Hint used");
            if (solutionViewed) details.push("Solution viewed");

            let message = "Puzzle solved!";

            if (details.length) {
                message += " " + details.join(" · ") + ".";
            } else {
                message += " Solved independently, without hints or viewing the solution!";
            }

            resultMessage.textContent = message;
            resultMessage.hidden = false;
            statusMessage.textContent = "All lights are ON.";
        }

        function resetGame() {
            board = [...initialBoard];
            moves = 0;
            hintUsed = false;
            solutionViewed = false;
            solved = false;
            hintedIndex = -1;
            solutionSteps = [];

            cells.forEach(cell => {
                cell.disabled = false;
            });

            hintButton.disabled = false;
            solveButton.disabled = false;

            resultMessage.hidden = true;
            hintPanel.hidden = true;
            statusMessage.textContent = "Turn every light ON to win.";

            renderBoard();
        }

        hintButton.addEventListener("click", useHint);
        solveButton.addEventListener("click", showSolution);
        resetButton.addEventListener("click", resetGame);

        createBoard();
    </script>
</body>
</html>
